{
  "Urls": "http://localhost:6001",
  "Security": {
    "Authentication": { "Mode": "Local" },
    "Authorization": { "Mode": "Local" },
    "LocalUserManagementMode": "Enabled",
    "Central": {
      "Authority": "http://localhost:5100",
      "Audience": "industrial-platform",
      "PermissionFailureMode": "FailClosed",
      "PermissionCacheMinutes": 5,
      "ShadowCentralAuthorization": false,
      "SystemCode": "IM",
      "ShadowUserProvisioning": "Disabled",
      "RequireSystemAccess": true,
      "AllowEmergencyLocalLogin": false
    },
    "ResourceSync": {
      "Enabled": false,
      "SystemCode": "IM",
      "ManifestPath": "permission-manifest.json",
      "ClientId": "im-service",
      "ClientSecret": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ImServerOption": {
    "RedisClient": "127.0.0.1:6379,poolsize=10",
    "Servers": "127.0.0.1:6001",
    "Server": "127.0.0.1:6001",
    "PublicWebSocketPath": "/im/ws"
  }
}
